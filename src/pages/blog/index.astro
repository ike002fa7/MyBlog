---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryBar from '../../components/CategoryBar.astro';

const posts = (await getCollection('blog')).sort((a,b) => b.data.date - a.data.date);

// 分类中文名映射
const catLabel = {
  'nod': '节点',
  'ter': '终端',
  'wrk': '工作台',
  'ker': '内核',
  'ovf': '溢出',
};
---
<BaseLayout title="博客" currentPath="/blog">
  <div class="mx-auto w-full max-w-6xl px-6 py-16 md:py-20">
    <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white">所有文章</h1>
        <div class="mt-2 flex items-center gap-3">
          <p class="font-mono text-sm text-gray-400 dark:text-gray-500">{posts.length} 篇文章</p>
          <div class="h-1 w-1 rounded-full bg-klein"></div>
          <p class="text-sm text-gray-400 dark:text-gray-500">按时间倒序</p>
        </div>
      </div>
      <div class="flex items-center gap-5 font-mono text-xs text-gray-400 dark:text-gray-500">
        <span class="text-gray-300 dark:text-gray-600">Total</span>
        <span class="inline-flex items-center gap-1.5"><svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg><span id="total-views">--</span></span>
        <span class="inline-flex items-center gap-1.5"><svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg><span id="total-likes">--</span></span>
        <span class="inline-flex items-center gap-1.5"><svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 01-.923 1.785A5.969 5.969 0 006 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337z"/></svg><span id="total-comments">--</span></span>
      </div>
    </div>
    <div class="mt-12">
    <CategoryBar limit={999} />
    </div>
    {posts.length === 0 ? (
      <div class="flex flex-col items-center justify-center py-20 text-gray-400 dark:text-gray-500">
        <svg class="mb-4 h-16 w-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
        <p class="font-mono text-sm">暂无文章</p>
      </div>
    ) : (
      <div class="grid gap-6 md:grid-cols-2 min-h-[200px]">
        {posts.map((p) => (
          <article class={`post-card group relative overflow-hidden rounded-2xl border border-gray-200 bg-gray-50 p-6 transition-all duration-300 hover:border-klein/30 hover:shadow-lg hover:shadow-klein/5 hover:-translate-y-1 dark:border-gray-800 dark:bg-gray-900 dark:hover:border-klein/40 dark:hover:shadow-klein/10`} data-category={p.data.category || 'ovf'}>
            <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-klein to-klein-400 opacity-0 transition-opacity group-hover:opacity-100"></div>
            <a href={`/blog/${p.slug}`} class="block">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-baseline sm:justify-between">
                <h2 class="text-lg font-semibold text-gray-900 transition-colors group-hover:text-klein dark:text-white dark:group-hover:text-klein-300">{p.data.title}</h2>
                <time class="shrink-0 font-mono text-xs text-gray-400 dark:text-gray-500">{p.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}</time>
              </div>
              {p.data.excerpt && <p class="mt-2 text-sm leading-relaxed text-gray-500 line-clamp-2 dark:text-gray-400">{p.data.excerpt}</p>}
            </a>
            <div class="mt-4 flex flex-wrap items-center gap-3">
              <span class="rounded-full bg-klein/10 px-2.5 py-0.5 font-mono text-[10px] font-medium text-klein dark:bg-klein/20 dark:text-klein-300">{catLabel[p.data.category] || '溢出'}</span>
              <span class="stats-counter inline-flex items-center gap-3 text-xs text-gray-400 dark:text-gray-500" data-slug={p.slug}>
                <span class="inline-flex items-center gap-1 font-mono"><svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg><span class="views-count">--</span></span>
                <span class="inline-flex items-center gap-1 font-mono"><svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg><span class="likes-count">--</span></span>
                <span class="inline-flex items-center gap-1 font-mono"><svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 01-.923 1.785A5.969 5.969 0 006 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337z"/></svg><span class="comments-count">--</span></span>
              </span>
              {p.data.tags && p.data.tags.map((tag) => (<span class="rounded-full bg-gray-100 px-2.5 py-0.5 font-mono text-[10px] text-gray-500 dark:bg-gray-800 dark:text-gray-400">#{tag}</span>))}
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<script defer src="/js/blog-stats.js"></script>
<script defer>
  // 总统计数据
  (function() {
    var SUPABASE_URL = 'https://eiakfxsvzmtvvfojtkln.supabase.co';
    var SUPABASE_KEY = 'sb_publishable_g6uC-elVHyXAGaI-zy7bKQ_SoXsodpc';
    fetch(SUPABASE_URL + '/rest/v1/blog_stats?select=views,likes,comments', {
      headers: { 'apikey': SUPABASE_KEY, 'Authorization': 'Bearer ' + SUPABASE_KEY }
    }).then(function(r) { return r.json(); }).then(function(rows) {
      var totalViews = 0, totalLikes = 0, totalComments = 0;
      rows.forEach(function(r) { totalViews += r.views || 0; totalLikes += r.likes || 0; totalComments += r.comments || 0; });
      animateCount('total-views', totalViews);
      animateCount('total-likes', totalLikes);
      animateCount('total-comments', totalComments);
    }).catch(function() {});
    function animateCount(id, target) {
      var el = document.getElementById(id);
      if (!el) return;
      var current = 0, step = Math.max(1, Math.ceil(target / 20));
      var timer = setInterval(function() {
        current += step;
        if (current >= target) { el.textContent = target; clearInterval(timer); }
        else { el.textContent = current; }
      }, 30);
    }
  })();
</script>
