---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  return (await getCollection('blog')).map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await post.render();
---
<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <article class="mx-auto max-w-4xl px-6 py-16">
    <header class="mb-12">
      {post.data.tags && <div class="mb-4 flex gap-2">{post.data.tags.map((t) => <span class="rounded-full bg-gray-100 px-2.5 py-0.5 font-mono text-xs text-gray-500">#{t}</span>)}</div>}
      <h1 class="text-4xl font-bold leading-tight tracking-tight text-gray-900">{post.data.title}</h1>
      <div class="mt-4 flex items-center justify-between">
        <time class="font-mono text-sm text-gray-400">{post.data.date.toLocaleDateString('zh-CN',{year:'numeric',month:'long',day:'numeric'})}</time>
        <span class="stats-counter inline-flex items-center gap-4 font-mono text-xs text-gray-400" data-slug={post.slug}>
          <span class="inline-flex items-center gap-1"><svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg><span class="views-count">0</span></span>
          <span class="inline-flex items-center gap-1"><svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg><span class="likes-count">0</span></span>
          <span class="inline-flex items-center gap-1"><svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 01-.923 1.785A5.969 5.969 0 006 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337z"/></svg><span class="comments-count">0</span></span>
        </span>
      </div>
    </header>
    <div class="prose prose-lg prose-gray max-w-none"><Content /></div>
    <div class="mt-12 flex items-center justify-between border-t border-gray-100 pt-8">
      <button class="like-btn group inline-flex items-center gap-2 font-mono text-sm text-gray-400 hover:text-klein transition-colors" data-slug={post.slug}>
        <svg class="h-5 w-5 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
        <span>点赞</span>
        <span class="like-count">0</span>
      </button>
      <a href="/blog" class="font-mono text-sm text-gray-400 hover:text-klein transition-colors">&larr; 返回列表</a>
    </div>
    <div class="giscus mt-16" data-slug={post.slug}></div>
  </article>
</BaseLayout>

<script defer>
  (function() {
    var SUPABASE_URL = 'https://eiakfxsvzmtvvfojtkln.supabase.co';
    var SUPABASE_KEY = 'sb_publishable_g6uC-elVHyXAGaI-zy7bKQ_SoXsodpc';
    var slug = document.querySelector('[data-slug]')?.getAttribute('data-slug');
    if (!slug) return;

    // ── 1. 浏览量 +1 ──
    fetch(SUPABASE_URL + '/rest/v1/rpc/increment_views', {
      method: 'POST',
      headers: { 'apikey': SUPABASE_KEY, 'Authorization': 'Bearer ' + SUPABASE_KEY, 'Content-Type': 'application/json' },
      body: JSON.stringify({ p_slug: slug })
    }).then(function(r) { return r.text(); }).then(function(count) {
      var el = document.querySelector('.views-count');
      if (el && count) el.textContent = count;
    });

    // ── 2. 读取点赞数 ──
    fetch(SUPABASE_URL + '/rest/v1/blog_stats?slug=eq.' + encodeURIComponent(slug) + '&select=likes', {
      headers: { 'apikey': SUPABASE_KEY, 'Authorization': 'Bearer ' + SUPABASE_KEY }
    }).then(function(r) { return r.json(); }).then(function(data) {
      if (data[0]) {
        var likes = data[0].likes || 0;
        var lel = document.querySelector('.likes-count');
        if (lel) lel.textContent = likes;
        var lbtn = document.querySelector('.like-count');
        if (lbtn && likes > 0) lbtn.textContent = likes;
      }
    });

    // ── 3. 点赞按钮 ──
    var likeBtn = document.querySelector('.like-btn');
    if (likeBtn) {
      likeBtn.addEventListener('click', function() {
        if (this.classList.contains('text-klein')) return;
        fetch(SUPABASE_URL + '/rest/v1/rpc/increment_likes', {
          method: 'POST',
          headers: { 'apikey': SUPABASE_KEY, 'Authorization': 'Bearer ' + SUPABASE_KEY, 'Content-Type': 'application/json' },
          body: JSON.stringify({ p_slug: slug })
        }).then(function(r) { return r.text(); }).then(function(count) {
          var lc = document.querySelector('.like-count');
          if (lc && count) lc.textContent = count;
          var ls = document.querySelector('.likes-count');
          if (ls && count) ls.textContent = count;
          document.querySelector('.like-btn').classList.add('text-klein');
        });
      });
    }

    // ── 4. Giscus 评论 + 监听评论数 ──
    window.addEventListener('message', function(event) {
      if (!event.origin.includes('giscus')) return;
      if (event.data?.giscus?.discussion) {
        var count = event.data.giscus.discussion.totalCommentCount;
        var cc = document.querySelector('.comments-count');
        if (cc && count != null) cc.textContent = count;
      }
    });

    var gs = document.createElement('script');
    gs.src = 'https://giscus.app/client.js';
    gs.setAttribute('data-repo', 'jynight/MyBlog');
    gs.setAttribute('data-repo-id', 'R_kgDOSZJ6kg');
    gs.setAttribute('data-category', 'General');
    gs.setAttribute('data-category-id', 'DIC_kwDOSZJ6ks4C8sa_');
    gs.setAttribute('data-mapping', 'specific');
    gs.setAttribute('data-term', slug);
    gs.setAttribute('data-reactions-enabled', '1');
    gs.setAttribute('data-emit-metadata', '1');
    gs.setAttribute('data-input-position', 'bottom');
    gs.setAttribute('data-theme', 'light');
    gs.setAttribute('data-lang', 'zh-CN');
    gs.setAttribute('crossorigin', 'anonymous');
    gs.async = true;
    document.querySelector('.giscus')?.appendChild(gs);
  })();
</script>
