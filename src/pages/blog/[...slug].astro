---
import { getCollection, getEntryBySlug } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatsCounter from '../../components/StatsCounter.astro';
import LikeButton from '../../components/LikeButton.astro';
import Giscus from '../../components/Giscus.astro';

export async function getStaticPaths() {
  return (await getCollection('blog')).map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await post.render();
---
<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <article class="mx-auto max-w-4xl px-6 py-16">
    <header class="mb-12">
      {post.data.tags && <div class="mb-4 flex gap-2">{post.data.tags.map((t) => <span class="rounded-full bg-gray-100 px-2.5 py-0.5 font-mono text-xs text-gray-500">#{t}</span>)}</div>}
      <h1 class="text-4xl font-bold leading-tight tracking-tight text-gray-900">{post.data.title}</h1>
      <div class="mt-4 flex items-center justify-between">
        <time class="font-mono text-sm text-gray-400">{post.data.date.toLocaleDateString('zh-CN',{year:'numeric',month:'long',day:'numeric'})}</time>
        <StatsCounter slug={post.slug} />
      </div>
    </header>
    <div class="prose prose-lg prose-gray max-w-none"><Content /></div>
    <div class="mt-12 flex items-center justify-between border-t border-gray-100 pt-8">
      <LikeButton slug={post.slug} />
      <a href="/blog" class="font-mono text-sm text-gray-400 hover:text-klein transition-colors">&larr; 返回列表</a>
    </div>
    <Giscus slug={post.slug} />
  </article>
</BaseLayout>
