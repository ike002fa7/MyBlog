---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { categoryMap, estimateReadingTime } from '../../config/blog';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      previousPost: posts[index - 1],
      nextPost: posts[index + 1],
      relatedPosts: posts.filter((item) => item.id !== post.id && item.data.category === post.data.category).slice(0, 2),
    },
  }));
}
const { post, previousPost, nextPost, relatedPosts } = Astro.props;
const { Content } = await render(post);
const readingTime = estimateReadingTime(post.body || '');

// 构建 canonical URL 和 ISO 日期
const canonicalURL = new URL(`/blog/${post.id}`, Astro.site).href;
const publishedTime = post.data.date.toISOString();
const modifiedTime = (post.data.updatedDate || post.data.date).toISOString();

// JSON-LD BlogPosting 结构化数据
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: publishedTime,
  dateModified: modifiedTime,
  author: {
    '@type': 'Person',
    name: 'Ike Bullen',
    url: 'https://kleinblue.top/about',
  },
  publisher: {
    '@type': 'Organization',
    name: 'X-ATCN',
    logo: {
      '@type': 'ImageObject',
      url: 'https://kleinblue.top/favicon.svg',
    },
  },
  url: canonicalURL,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
  ...(post.data.tags?.length && { keywords: post.data.tags.join(', ') }),
};
---
<BaseLayout
  title={post.data.title}
  description={post.data.excerpt}
  currentPath="/blog"
  type="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  canonicalURL={canonicalURL}
  image={post.data.cover}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {post.data.tags?.length && <meta name="keywords" content={post.data.tags.join(', ')} />}
  </Fragment>
  <article class="mx-auto w-full max-w-6xl px-6 py-12 md:py-16">
    <!-- 文章头部 -->
    <header class="mb-10">
      {post.data.tags && (
        <div class="mb-5 flex flex-wrap gap-2 items-center">
          <span class="rounded-full bg-klein/10 px-3 py-1 font-mono text-xs font-medium text-klein border border-klein/20 dark:bg-klein/20 dark:border-klein/40 dark:text-klein-300">{categoryMap[post.data.category].label}</span>
          {post.data.tags.map((t) => <span class="rounded-full bg-klein/8 px-3 py-1 font-mono text-xs font-medium text-klein dark:bg-klein/20 dark:text-klein-300">#{t}</span>)}
        </div>
      )}
      <h1 class="text-4xl font-extrabold leading-tight tracking-tight text-gray-900 md:text-5xl dark:text-white">{post.data.title}</h1>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <time class="inline-flex items-center gap-2 font-mono text-sm text-gray-400 dark:text-gray-500">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          {post.data.date.toLocaleDateString('zh-CN',{year:'numeric',month:'long',day:'numeric'})}
        </time>
        <span class="h-1 w-1 rounded-full bg-gray-300 dark:bg-gray-600"></span>
        <span class="font-mono text-xs text-gray-400 dark:text-gray-500">{readingTime} 分钟阅读</span>
        {post.data.updatedDate && (
          <>
            <span class="h-1 w-1 rounded-full bg-gray-300 dark:bg-gray-600"></span>
            <time class="font-mono text-xs text-gray-400 dark:text-gray-500" datetime={modifiedTime}>更新于 {post.data.updatedDate.toLocaleDateString('zh-CN')}</time>
          </>
        )}
        <span class="stats-counter inline-flex items-center gap-3 font-mono text-xs text-gray-400 dark:text-gray-500" data-slug={post.id}>
          <span class="inline-flex items-center gap-1"><svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg><span class="views-count">--</span></span>
          <span class="inline-flex items-center gap-1"><svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg><span class="likes-count">--</span></span>
          <span class="inline-flex items-center gap-1"><svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 01-.923 1.785A5.969 5.969 0 006 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337z"/></svg><span class="comments-count">--</span></span>
        </span>
      </div>
    </header>

    <!-- 文章正文 -->
    <div class="prose prose-lg prose-gray mx-auto max-w-3xl dark:prose-invert">
      <TableOfContents />
      <Content />
      {post.data.references.length > 0 && (
        <section aria-labelledby="references-title">
          <h2 id="references-title">参考资料</h2>
          <ul>
            {post.data.references.map((reference) => (
              <li><a href={reference.url} target="_blank" rel="noopener noreferrer">{reference.title}</a></li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <nav class="mx-auto mt-14 grid max-w-3xl gap-4 border-t border-gray-100 pt-8 sm:grid-cols-2 dark:border-gray-800" aria-label="文章翻页">
      {previousPost ? (
        <a href={`/blog/${previousPost.id}`} class="group rounded-xl border border-gray-200 p-4 transition hover:border-klein/40 dark:border-gray-800">
          <span class="font-mono text-xs text-gray-400">← 上一篇</span>
          <strong class="mt-2 block text-sm group-hover:text-klein">{previousPost.data.title}</strong>
        </a>
      ) : <span />}
      {nextPost && (
        <a href={`/blog/${nextPost.id}`} class="group rounded-xl border border-gray-200 p-4 text-right transition hover:border-klein/40 dark:border-gray-800">
          <span class="font-mono text-xs text-gray-400">下一篇 →</span>
          <strong class="mt-2 block text-sm group-hover:text-klein">{nextPost.data.title}</strong>
        </a>
      )}
    </nav>

    {relatedPosts.length > 0 && (
      <section class="mx-auto mt-10 max-w-3xl" aria-labelledby="related-title">
        <h2 id="related-title" class="mb-4 font-mono text-xs uppercase tracking-[.2em] text-gray-400">同分类延伸阅读</h2>
        <div class="grid gap-3 sm:grid-cols-2">
          {relatedPosts.map((item) => (
            <a href={`/blog/${item.id}`} class="rounded-xl bg-gray-50 p-4 text-sm font-semibold transition hover:text-klein dark:bg-gray-900">{item.data.title}</a>
          ))}
        </div>
      </section>
    )}

    <!-- 底部交互栏 -->
    <div class="mt-16 flex items-center justify-between border-t border-gray-100 pt-8 dark:border-gray-800">
      <button class="like-btn group relative inline-flex items-center gap-2.5 overflow-hidden rounded-xl border border-gray-200 px-5 py-2.5 font-mono text-sm text-gray-500 transition-all hover:border-klein/40 hover:text-klein dark:border-gray-700 dark:text-gray-400 dark:hover:border-klein/40 dark:hover:text-klein-300" data-slug={post.id} type="button" aria-pressed="false" aria-label="为这篇文章点赞">
        <!-- 心形图标动画 -->
        <span class="like-icon relative flex h-5 w-5 items-center justify-center">
          <svg class="heart-outline h-5 w-5 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
          <svg class="heart-filled hidden h-5 w-5 text-klein" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.645 20.91a.75.75 0 0 0 .71 0l.102-.058C18.684 17.294 22 13.21 22 8.75A5.75 5.75 0 0 0 12 4.87 5.75 5.75 0 0 0 2 8.75c0 4.46 3.316 8.544 9.543 12.102l.102.058Z"/></svg>
        </span>
        <span class="like-label">点赞</span>
        <span class="like-count font-semibold">--</span>
      </button>
      <a href="/blog" class="inline-flex items-center gap-1 font-mono text-sm text-gray-400 transition-colors hover:text-klein dark:text-gray-500 dark:hover:text-klein-300">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16l-4-4m0 0l4-4m-4 4h18"/></svg>
        返回列表
      </a>
    </div>

    <!-- Giscus 评论区 -->
    <div class="giscus mt-12" data-slug={post.id}></div>
  </article>
</BaseLayout>

<script defer>
  (function() {
    var SUPABASE_URL = 'https://vbfbgzfiyhbjhmlmlzhs.supabase.co';
    var SUPABASE_KEY = 'sb_publishable_o-YKAsUGWfLRXFAf7v3uTw_l8OI2wMv';
    var slug = document.querySelector('[data-slug]')?.getAttribute('data-slug');
    if (!slug) return;

    // ── 1. 浏览量 +1 ──
    fetch(SUPABASE_URL + '/rest/v1/rpc/increment_views', {
      method: 'POST',
      headers: { 'apikey': SUPABASE_KEY, 'Authorization': 'Bearer ' + SUPABASE_KEY, 'Content-Type': 'application/json' },
      body: JSON.stringify({ p_slug: slug })
    }).then(function(r) { return r.text(); }).then(function(count) {
      var el = document.querySelector('.views-count');
      if (el && count) animateCount(el, parseInt(count) || 0);
    });

    // ── 2. 读取点赞数 ──
    fetch(SUPABASE_URL + '/rest/v1/blog_stats?slug=eq.' + encodeURIComponent(slug) + '&select=likes', {
      headers: { 'apikey': SUPABASE_KEY, 'Authorization': 'Bearer ' + SUPABASE_KEY }
    }).then(function(r) { return r.json(); }).then(function(data) {
      if (data[0]) {
        var likes = data[0].likes || 0;
        updateLikeUI(likes, localStorage.getItem('liked:' + slug) === '1', false);
      }
    });

    // ── 3. 点赞按钮（心形动画）──
    var likeBtn = document.querySelector('.like-btn');
    if (likeBtn) {
      likeBtn.addEventListener('click', function() {
        if (likeBtn.classList.contains('liked')) return;
        fetch(SUPABASE_URL + '/rest/v1/rpc/increment_likes', {
          method: 'POST',
          headers: { 'apikey': SUPABASE_KEY, 'Authorization': 'Bearer ' + SUPABASE_KEY, 'Content-Type': 'application/json' },
          body: JSON.stringify({ p_slug: slug })
        }).then(function(r) { return r.text(); }).then(function(count) {
          localStorage.setItem('liked:' + slug, '1');
          updateLikeUI(parseInt(count) || 0, true, true);
        });
      });
    }

    function updateLikeUI(likes, liked, animate) {
      var lc = document.querySelector('.like-count');
      var ls = document.querySelector('.likes-count');
      if (lc) lc.textContent = likes;
      if (ls) ls.textContent = likes;
      var btn = document.querySelector('.like-btn');
      if (!btn) return;
      if (liked) {
        btn.classList.add('liked');
        btn.setAttribute('aria-pressed', 'true');
        btn.setAttribute('aria-label', '已为这篇文章点赞');
        var outline = btn.querySelector('.heart-outline');
        var filled = btn.querySelector('.heart-filled');
        if (outline) outline.classList.add('hidden');
        if (filled) filled.classList.remove('hidden');
        var label = btn.querySelector('.like-label');
        if (label) label.textContent = '已赞';
        if (animate && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          if (filled && typeof filled.animate === 'function') {
            filled.animate([
              { transform: 'scale(.35)', opacity: .2 },
              { transform: 'scale(1.35)', opacity: 1, offset: .65 },
              { transform: 'scale(1)', opacity: 1 }
            ], { duration: 420, easing: 'cubic-bezier(.2,.8,.2,1)' });
          }
          if (typeof btn.animate === 'function') {
            btn.animate([
              { transform: 'scale(1)' },
              { transform: 'scale(1.08)' },
              { transform: 'scale(1)' }
            ], { duration: 260, easing: 'ease-out' });
          }
        }
      }
    }

    // 数字递增
    function animateCount(el, target) {
      if (!el) return;
      el.classList.add('stat-loaded');
      var current = 0;
      var step = Math.max(1, Math.ceil(target / 20));
      var timer = setInterval(function() {
        current += step;
        if (current >= target) { el.textContent = target; clearInterval(timer); }
        else { el.textContent = current; }
      }, 30);
    }

    // ── 4. Giscus 评论 + 监听评论数 ──
    window.addEventListener('message', function(event) {
      if (event.origin !== 'https://giscus.app') return;
      var frame = document.querySelector('.giscus-frame');
      if (frame && event.source !== frame.contentWindow) return;
      if (!event.data || typeof event.data !== 'object' || !event.data.giscus) return;
      if ('discussion' in event.data.giscus) {
        var d = event.data.giscus.discussion;
        if (!d) {
          var emptyCount = document.querySelector('.comments-count');
          if (emptyCount) emptyCount.textContent = '0';
          return;
        }
        var count = (d.totalCommentCount || 0) + (d.totalReplyCount || 0);
        var cc = document.querySelector('.comments-count');
        if (cc) cc.textContent = String(count);
      } else if ('error' in event.data.giscus) {
        var errorCount = document.querySelector('.comments-count');
        if (errorCount) {
          errorCount.textContent = '—';
          errorCount.title = '评论统计暂时不可用';
        }
      }
    });

    // Giscus 组件
    var gs = document.createElement('script');
    gs.src = 'https://giscus.app/client.js';
    gs.setAttribute('data-repo', 'ike002fa7/MyBlog');
    gs.setAttribute('data-repo-id', 'R_kgDOSZJ6kg');
    gs.setAttribute('data-category', 'General');
    gs.setAttribute('data-category-id', 'DIC_kwDOSZJ6ks4C8sa_');
    gs.setAttribute('data-mapping', 'pathname');
    gs.setAttribute('data-reactions-enabled', '1');
    gs.setAttribute('data-emit-metadata', '1');
    gs.setAttribute('data-input-position', 'bottom');
    gs.setAttribute('data-theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');
    gs.setAttribute('data-lang', 'zh-CN');
    gs.setAttribute('crossorigin', 'anonymous');
    gs.async = true;
    document.querySelector('.giscus')?.appendChild(gs);
  })();
</script>

<style>
  /* 代码块复制按钮 */
  .prose pre { position: relative; }
  .prose pre:hover .copy-btn { opacity: 1; }
  .copy-btn {
    position: absolute; top: 8px; right: 8px;
    padding: 4px 10px; font-size: 11px; font-family: 'JetBrains Mono', monospace;
    border-radius: 6px; border: 1px solid #374151; background: #1f2937; color: #9ca3af;
    cursor: pointer; opacity: 0; transition: opacity .2s;
  }
  .copy-btn:hover { background: #374151; color: #f3f4f6; }
  .copy-btn.copied { color: #34d399; border-color: #34d399; }
</style>

<script defer>
  // 代码块复制按钮
  document.querySelectorAll('.prose pre').forEach(function(pre) {
    var btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.textContent = '复制';
    btn.addEventListener('click', function() {
      var code = pre.querySelector('code');
      if (!code) return;
      navigator.clipboard.writeText(code.textContent || '').then(function() {
        btn.textContent = '✓ 已复制';
        btn.classList.add('copied');
        setTimeout(function() { btn.textContent = '复制'; btn.classList.remove('copied'); }, 2000);
      });
    });
    pre.appendChild(btn);
  });
</script>
