<!--
  TableOfContents.astro
  文章目录组件 — 构建时自动扫描 .prose 下 h2/h3 生成锚点目录
  采用终端风格 UI，克莱因蓝 (#002FA7) 点缀
-->
<div class="toc-wrapper relative mb-10">
  <!-- 折叠开关 -->
  <details class="toc-details group cursor-pointer select-none" open>
    <summary class="toc-summary mb-4 inline-flex items-center gap-2 font-mono text-xs text-gray-400 transition-colors hover:text-klein dark:text-gray-500 dark:hover:text-klein-300">
      <svg class="toc-chevron h-3.5 w-3.5 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
      <span class="font-semibold tracking-wider"># 目录</span>
      <span class="toc-count ml-1 rounded bg-gray-100 px-1.5 py-0.5 text-[10px] dark:bg-gray-800"></span>
    </summary>
    <nav class="toc-nav border-l-2 border-gray-200 pl-4 dark:border-gray-700">
      <!-- 由 JS 动态填充 -->
    </nav>
  </details>
</div>

<style>
  .toc-wrapper {
    scroll-margin-top: 2rem;
  }
  .toc-nav {
    max-height: 60vh;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #002FA7 transparent;
  }
  .toc-nav::-webkit-scrollbar {
    width: 4px;
  }
  .toc-nav::-webkit-scrollbar-thumb {
    background: #002FA7;
    border-radius: 2px;
  }
</style>

<script is:inline>
(function() {
  function initTOC() {
    var prose = document.querySelector('.prose');
    if (!prose) return;

    var nav = document.querySelector('.toc-nav');
    var countEl = document.querySelector('.toc-count');
    if (!nav) return;

    // ── 1. 扫描所有 h2 / h3，注入 id ──
    var headings = prose.querySelectorAll('h2, h3');
    if (headings.length === 0) {
      var details = document.querySelector('.toc-details');
      if (details) details.style.display = 'none';
      return;
    }

    var items = [];
    // 暗色模式检测
    var isDark = document.documentElement.classList.contains('dark');
    var defaultColor = isDark ? '#9ca3af' : '#6b7280';
    var h3Color = isDark ? '#6b7280' : '#9ca3af';
    var hoverColor = isDark ? '#1A67FF' : '#002FA7';
    headings.forEach(function(h, i) {
      if (!h.id) {
        h.id = 'heading-' + i;
      }
      items.push({
        tag: h.tagName.toLowerCase(),
        text: h.textContent.trim(),
        id: h.id
      });
    });

    // ── 2. 渲染目录（使用 DOM API 而非 innerHTML，避免 astro scoped css 不匹配）──
    items.forEach(function(item) {
      var a = document.createElement('a');
      a.href = '#' + item.id;
      a.textContent = item.text;
      a.setAttribute('data-target', item.id);
      // 直接内联样式，避免 astro scoped css 不匹配
      a.style.display = 'block';
      a.style.padding = '3px 0';
      a.style.fontFamily = "'JetBrains Mono', 'Inter', monospace";
      a.style.fontSize = '13px';
      a.style.lineHeight = '1.5';
      a.style.color = defaultColor;
      a.style.textDecoration = 'none';
      a.style.transition = 'all .15s ease';
      a.style.borderLeft = '2px solid transparent';
      a.style.marginLeft = '-18px';
      a.style.paddingLeft = '16px';
      if (item.tag === 'h3') {
        a.style.paddingLeft = '32px';
        a.style.fontSize = '12px';
        a.style.color = h3Color;
      }
      // hover 效果用 mouseenter/mouseleave
      a.addEventListener('mouseenter', function() {
        this.style.color = hoverColor;
        this.style.borderLeftColor = hoverColor;
      });
      a.addEventListener('mouseleave', function() {
        this.style.color = item.tag === 'h3' ? h3Color : defaultColor;
        this.style.borderLeftColor = 'transparent';
      });
      // 点击平滑滚动
      a.addEventListener('click', function(e) {
        e.preventDefault();
        var target = document.getElementById(item.id);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', '#' + item.id);
        }
      });
      nav.appendChild(a);
    });

    if (countEl) countEl.textContent = items.length;

    // ── 3. 高亮当前可见章节 ──
    function updateActive() {
      var links = nav.querySelectorAll('a');
      var scrollTop = window.scrollY + 80;

      var activeId = null;
      headings.forEach(function(h) {
        if (h.offsetTop <= scrollTop) {
          activeId = h.id;
        }
      });

      links.forEach(function(link) {
        var target = link.getAttribute('data-target');
        if (target === activeId) {
          link.style.color = hoverColor;
          link.style.borderLeftColor = hoverColor;
          link.style.fontWeight = '600';
        } else {
          var isH3 = items.find(function(i) { return i.id === target; })?.tag === 'h3';
          link.style.color = isH3 ? h3Color : defaultColor;
          link.style.borderLeftColor = 'transparent';
          link.style.fontWeight = 'normal';
        }
      });
    }

    window.addEventListener('scroll', updateActive, { passive: true });
    setTimeout(updateActive, 100);

    function escapeHtml(str) {
      var d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }
  }

  // 等页面完全加载后再初始化 TOC（确保 <Content /> 已渲染）
  if (document.readyState === 'complete') {
    initTOC();
  } else {
    window.addEventListener('load', initTOC);
  }
})();
</script>
