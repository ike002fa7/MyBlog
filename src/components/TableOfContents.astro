<!--
  TableOfContents.astro
  文章目录组件 — 构建时自动扫描 .prose 下 h2/h3 生成锚点目录
  采用终端风格 UI，克莱因蓝 (#002FA7) 点缀
-->
<div class="toc-wrapper relative mb-10">
  <!-- 折叠开关 -->
  <details class="toc-details group cursor-pointer select-none" open>
    <summary class="toc-summary mb-4 inline-flex items-center gap-2 font-mono text-xs text-gray-400 transition-colors hover:text-klein dark:text-gray-500 dark:hover:text-klein-300">
      <svg class="toc-chevron h-3.5 w-3.5 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
      <span class="font-semibold tracking-wider"># 目录</span>
      <span class="toc-count ml-1 rounded bg-gray-100 px-1.5 py-0.5 text-[10px] dark:bg-gray-800"></span>
    </summary>
    <nav class="toc-nav border-l-2 border-gray-200 pl-4 dark:border-gray-700">
      <!-- 由 JS 动态填充 -->
    </nav>
  </details>
</div>

<style>
  .toc-wrapper {
    scroll-margin-top: 2rem;
  }
  .toc-nav {
    max-height: 60vh;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #002FA7 transparent;
  }
  .toc-nav::-webkit-scrollbar {
    width: 4px;
  }
  .toc-nav::-webkit-scrollbar-thumb {
    background: #002FA7;
    border-radius: 2px;
  }
  .toc-nav a {
    display: block;
    padding: 3px 0;
    font-family: 'JetBrains Mono', 'Inter', monospace;
    font-size: 13px;
    line-height: 1.5;
    color: #6b7280;
    text-decoration: none;
    transition: all 0.15s ease;
    border-left: 2px solid transparent;
    margin-left: -18px;
    padding-left: 16px;
  }
  .toc-nav a:hover {
    color: #002FA7;
    border-left-color: #002FA7;
  }
  .dark .toc-nav a {
    color: #9ca3af;
  }
  .dark .toc-nav a:hover {
    color: #1A67FF;
    border-left-color: #1A67FF;
  }
  .toc-nav a.toc-h3 {
    padding-left: 32px;
    font-size: 12px;
    color: #9ca3af;
  }
  .dark .toc-nav a.toc-h3 {
    color: #6b7280;
  }
  .toc-nav a.toc-active {
    color: #002FA7;
    border-left-color: #002FA7;
    font-weight: 600;
  }
  .dark .toc-nav a.toc-active {
    color: #1A67FF;
    border-left-color: #1A67FF;
  }
</style>

<script is:inline>
(function() {
  function initTOC() {
    var prose = document.querySelector('.prose');
    if (!prose) return;

    var nav = document.querySelector('.toc-nav');
    var countEl = document.querySelector('.toc-count');
    if (!nav) return;

    // ── 1. 扫描所有 h2 / h3，注入 id ──
    var headings = prose.querySelectorAll('h2, h3');
    if (headings.length === 0) {
      var details = document.querySelector('.toc-details');
      if (details) details.style.display = 'none';
      return;
    }

    var items = [];
    headings.forEach(function(h, i) {
      // 跳过已经有 id 的
      if (!h.id) {
        h.id = 'heading-' + i;
      }
      items.push({
        tag: h.tagName.toLowerCase(),
        text: h.textContent.trim(),
        id: h.id
      });
    });

    // ── 2. 渲染目录 ──
    var html = '';
    items.forEach(function(item) {
      var cls = item.tag === 'h3' ? 'toc-h3' : '';
      html += '<a href="#' + item.id + '" class="' + cls + '" data-target="' + item.id + '">' + escapeHtml(item.text) + '</a>';
    });
    nav.innerHTML = html;
    if (countEl) countEl.textContent = items.length;

    // ── 3. 高亮当前可见章节 ──
    function updateActive() {
      var links = nav.querySelectorAll('a');
      var scrollTop = window.scrollY + 80;

      var activeId = null;
      headings.forEach(function(h) {
        if (h.offsetTop <= scrollTop) {
          activeId = h.id;
        }
      });

      links.forEach(function(link) {
        var target = link.getAttribute('data-target');
        if (target === activeId) {
          link.classList.add('toc-active');
        } else {
          link.classList.remove('toc-active');
        }
      });
    }

    window.addEventListener('scroll', updateActive, { passive: true });
    setTimeout(updateActive, 100);

    // ── 4. 点击平滑滚动 ──
    nav.addEventListener('click', function(e) {
      var link = e.target.closest('a');
      if (!link) return;
      e.preventDefault();
      var id = link.getAttribute('data-target');
      var target = document.getElementById(id);
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', '#' + id);
      }
    });

    function escapeHtml(str) {
      var d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }
  }

  // 等页面完全加载后再初始化 TOC（确保 <Content /> 已渲染）
  if (document.readyState === 'complete') {
    initTOC();
  } else {
    window.addEventListener('load', initTOC);
  }
})();
</script>
