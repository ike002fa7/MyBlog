---
interface Props { limit?: number; }
const { limit = 4 } = Astro.props;
---
<div id="category-bar" class="mb-8 flex flex-wrap items-center gap-2" data-limit={String(limit)}>
  <button class="cat-btn rounded-full px-4 py-1.5 text-xs font-medium transition-all bg-klein text-white shadow-sm shadow-klein/20" data-cat="全部">全部</button>
  <button class="cat-btn rounded-full border border-gray-200 bg-white px-4 py-1.5 text-xs font-medium text-gray-500 transition-all hover:border-klein/30 hover:text-klein dark:border-gray-700 dark:bg-gray-900 dark:text-gray-400 dark:hover:border-klein/40 dark:hover:text-klein-300" data-cat="技术">技术</button>
  <button class="cat-btn rounded-full border border-gray-200 bg-white px-4 py-1.5 text-xs font-medium text-gray-500 transition-all hover:border-klein/30 hover:text-klein dark:border-gray-700 dark:bg-gray-900 dark:text-gray-400 dark:hover:border-klein/40 dark:hover:text-klein-300" data-cat="工具">工具</button>
  <button class="cat-btn rounded-full border border-gray-200 bg-white px-4 py-1.5 text-xs font-medium text-gray-500 transition-all hover:border-klein/30 hover:text-klein dark:border-gray-700 dark:bg-gray-900 dark:text-gray-400 dark:hover:border-klein/40 dark:hover:text-klein-300" data-cat="VPS">VPS</button>
  <button class="cat-btn rounded-full border border-gray-200 bg-white px-4 py-1.5 text-xs font-medium text-gray-500 transition-all hover:border-klein/30 hover:text-klein dark:border-gray-700 dark:bg-gray-900 dark:text-gray-400 dark:hover:border-klein/40 dark:hover:text-klein-300" data-cat="AI">AI</button>
  <button class="cat-btn rounded-full border border-gray-200 bg-white px-4 py-1.5 text-xs font-medium text-gray-500 transition-all hover:border-klein/30 hover:text-klein dark:border-gray-700 dark:bg-gray-900 dark:text-gray-400 dark:hover:border-klein/40 dark:hover:text-klein-300" data-cat="3C数码">3C数码</button>
</div>

<script>
  (function() {
    var bar = document.getElementById('category-bar');
    var limit = parseInt(bar.getAttribute('data-limit')) || 4;
    var btns = document.querySelectorAll('.cat-btn');

    function filterPosts(cat) {
      var cards = document.querySelectorAll('.post-card');
      var shown = 0;
      cards.forEach(function(card) {
        var match = cat === '全部' || card.getAttribute('data-category') === cat;
        if (match && shown < limit) {
          card.style.display = '';
          shown++;
        } else {
          card.style.display = 'none';
        }
      });
      var countEl = document.getElementById('visible-count');
      if (countEl) countEl.textContent = cat === '全部' ? '' : ' · ' + cat;
    }

    btns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        btns.forEach(function(b) {
          b.className = 'cat-btn rounded-full border border-gray-200 bg-white px-4 py-1.5 text-xs font-medium text-gray-500 transition-all hover:border-klein/30 hover:text-klein dark:border-gray-700 dark:bg-gray-900 dark:text-gray-400 dark:hover:border-klein/40 dark:hover:text-klein-300';
        });
        btn.className = 'cat-btn rounded-full px-4 py-1.5 text-xs font-medium transition-all bg-klein text-white shadow-sm shadow-klein/20';
        filterPosts(btn.getAttribute('data-cat'));
      });
    });

    // 初始化：页面加载后立即过滤
    filterPosts('全部');
  })();
</script>
