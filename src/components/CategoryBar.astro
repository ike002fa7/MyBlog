---
interface Props { limit?: number; }
const { limit = 4 } = Astro.props;

// 分类配置：slug → 显示名（中文名 / 英文缩写）
const categories = [
  { slug: '全部', label: '全部' },
  { slug: 'nod', label: '节点 / nod' },
  { slug: 'ter', label: '终端 / ter' },
  { slug: 'wrk', label: '工作台 / wrk' },
  { slug: 'ker', label: '内核 / ker' },
  { slug: 'ovf', label: '溢出 / ovf' },
];
---

<div id="category-bar" class="mb-8 flex flex-wrap items-center gap-2" data-limit={String(limit)}>
  {categories.map((cat, i) => (
    <button
      class:list={[
        'cat-btn rounded-full px-4 py-1.5 text-xs font-medium transition-all',
        i === 0
          ? 'bg-klein text-white shadow-sm shadow-klein/20'
          : 'border border-gray-200 bg-white px-4 py-1.5 text-xs font-medium text-gray-500 transition-all hover:border-klein/30 hover:text-klein dark:border-gray-700 dark:bg-gray-900 dark:text-gray-400 dark:hover:border-klein/40 dark:hover:text-klein-300'
      ]}
      data-cat={cat.slug}
    >{cat.label}</button>
  ))}
</div>

<script>
  (function() {
    var bar = document.getElementById('category-bar');
    var limit = parseInt(bar.getAttribute('data-limit')) || 4;
    var btns = document.querySelectorAll('.cat-btn');

    function filterPosts(cat) {
      var cards = document.querySelectorAll('.post-card');
      var shown = 0;
      cards.forEach(function(card) {
        var match = cat === '全部' || card.getAttribute('data-category') === cat;
        if (match && shown < limit) {
          card.style.display = '';
          shown++;
        } else {
          card.style.display = 'none';
        }
      });
      var countEl = document.getElementById('visible-count');
      if (countEl) countEl.textContent = cat === '全部' ? '' : ' · ' + cat;
    }

    btns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        btns.forEach(function(b) {
          b.className = 'cat-btn rounded-full border border-gray-200 bg-white px-4 py-1.5 text-xs font-medium text-gray-500 transition-all hover:border-klein/30 hover:text-klein dark:border-gray-700 dark:bg-gray-900 dark:text-gray-400 dark:hover:border-klein/40 dark:hover:text-klein-300';
        });
        btn.className = 'cat-btn rounded-full px-4 py-1.5 text-xs font-medium transition-all bg-klein text-white shadow-sm shadow-klein/20';
        filterPosts(btn.getAttribute('data-cat'));
      });
    });

    // 初始化：页面加载后立即过滤
    filterPosts('全部');
  })();
</script>
