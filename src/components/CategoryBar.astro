---
interface Props { limit?: number; }
const { limit = 4 } = Astro.props;

// 分类配置：slug → 显示名（中文名 / 英文缩写）
const categories = [
  { slug: '全部', label: '全部 / all', tip: '聚合所有维度的内容与思考' },
  { slug: 'nod', label: '节点 / nod', tip: '构成数字世界的底层基础设施与计算力' },
  { slug: 'ter', label: '终端 / ter', tip: '人与数字世界交互的物理边界' },
  { slug: 'wrk', label: '工作台 / wrk', tip: '个人数字环境的构建与秩序' },
  { slug: 'ker', label: '内核 / ker', tip: '驱动一切运转的底层思维逻辑和个人沉淀' },
  { slug: 'ovf', label: '溢出 / ovf', tip: '无规则的蔓延' },
];
---

<!-- 分类导航栏 -->
<div id="category-bar" class="mb-8 flex flex-wrap items-center gap-2" data-limit={String(limit)}>
  {categories.map((cat, i) => (
    <div class="group relative">
      <button
        class:list={[
          'cat-btn rounded-full px-4 py-1.5 text-xs font-medium transition-all',
          i === 0
            ? 'bg-klein text-white shadow-sm shadow-klein/20'
            : 'border border-gray-200 bg-white px-4 py-1.5 text-xs font-medium text-gray-500 transition-all hover:border-klein/30 hover:text-klein dark:border-gray-700 dark:bg-gray-900 dark:text-gray-400 dark:hover:border-klein/40 dark:hover:text-klein-300'
        ]}
        data-cat={cat.slug}
      >{cat.label}</button>
      <!-- 悬浮 HUD 提示 - 左侧克莱因蓝竖线，无箭头，浮现动效，双主题自适应 -->
      <div class="pointer-events-none absolute left-1/2 top-full z-50 mt-2.5 -translate-x-1/2 whitespace-nowrap leading-none rounded px-2 py-0.5 text-[11px] font-normal tracking-wide opacity-0 transition-all duration-200 ease-out translate-y-1 group-hover:translate-y-0 group-hover:opacity-100 group-hover:delay-150 bg-white text-[#9CA3AF] shadow-[0_4px_20px_rgba(0,0,0,0.08)] dark:bg-[#18181B] dark:text-[#9CA3AF] dark:shadow-[0_4px_20px_rgba(0,0,0,0.5)]" style="border-left:2px solid #002FA7;">
        {cat.tip}
      </div>
    </div>
  ))}
</div>

<script>
  (function() {
    var bar = document.getElementById('category-bar');
    var limit = parseInt(bar.getAttribute('data-limit')) || 4;
    var btns = document.querySelectorAll('.cat-btn');
    var container = bar.parentElement;

    // 分类中文名映射（与 index.astro 同步）
    var catLabel = {
      '全部': '全部',
      'nod': '节点',
      'ter': '终端',
      'wrk': '工作台',
      'ker': '内核',
      'ovf': '溢出',
    };

    function filterPosts(cat) {
      var cards = document.querySelectorAll('.post-card');
      var emptyState = document.getElementById('empty-state');
      var shown = 0;
      cards.forEach(function(card) {
        var match = cat === '全部' || card.getAttribute('data-category') === cat;
        if (match && shown < limit) {
          card.style.display = '';
          shown++;
        } else {
          card.style.display = 'none';
        }
      });

      // 空状态控制
      if (emptyState) {
        if (shown === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }

      // 当文章数少于2时仍保留2列宽度（不改变布局）
      var grid = document.querySelector('.grid');
      if (grid && shown === 1) {
        grid.style.gridTemplateColumns = 'repeat(2, 1fr)';
        // 把唯一的卡片放到左边
        cards.forEach(function(c) {
          if (c.style.display !== 'none') {
            c.style.gridColumn = '1';
          }
        });
      } else if (grid) {
        grid.style.gridTemplateColumns = '';
        cards.forEach(function(c) { c.style.gridColumn = ''; });
      }
      var countEl = document.getElementById('visible-count');
      if (countEl) countEl.textContent = cat === '全部' ? '' : ' · ' + (catLabel[cat] || cat);
    }

    var activeClass = 'bg-klein text-white shadow-sm shadow-klein/20';
    var inactiveClass = 'cat-btn rounded-full border border-gray-200 bg-white px-4 py-1.5 text-xs font-medium text-gray-500 transition-all hover:border-klein/30 hover:text-klein dark:border-gray-700 dark:bg-gray-900 dark:text-gray-400 dark:hover:border-klein/40 dark:hover:text-klein-300';

    btns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        btns.forEach(function(b) { b.className = inactiveClass; });
        btn.className = 'cat-btn rounded-full px-4 py-1.5 text-xs font-medium transition-all ' + activeClass;
        filterPosts(btn.getAttribute('data-cat'));
      });
    });

    // 初始化：页面加载后立即过滤
    filterPosts('全部');
  })();
</script>
