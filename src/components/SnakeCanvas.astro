<!--
  SnakeCanvas.astro
  像素贪吃蛇循环动画 — 寓意接收知识，不断成长
  8-bit 风格 Canvas，放在博客页 header 旁
-->
<canvas id="snake-canvas" width="160" height="160" aria-hidden="true"></canvas>

<style>
  #snake-canvas {
    display: block;
    width: 80px;
    height: 80px;
    image-rendering: pixelated;
    border-radius: 12px;
    border: 1px solid #e5e7eb;
    background: #0d1117;
    flex-shrink: 0;
  }
  .dark #snake-canvas {
    border-color: #1f2937;
  }
</style>

<script is:inline>
(function() {
  var canvas = document.getElementById('snake-canvas');
  if (!canvas) return;

  var ctx = canvas.getContext('2d');

  // ── 像素尺寸 ──
  var COLS = 16;
  var ROWS = 16;
  var TILE = 10;  // 160 / 16

  // ── 方向常量 ──
  var UP = { x: 0, y: -1 };
  var DOWN = { x: 0, y: 1 };
  var LEFT = { x: -1, y: 0 };
  var RIGHT = { x: 1, y: 0 };

  // ── 主蛇（蓝色 #002FA7）──
  var snake = [
    { x: 2, y: 8 },
    { x: 1, y: 8 },
    { x: 0, y: 8 },
  ];
  var dir = RIGHT;
  var nextDir = RIGHT;
  var growing = false;

  // ── 食物 ──
  var food = { x: 12, y: 8 };

  // ── 次要蛇（金色，#FFB000，方向相反走着玩）──
  var snake2 = [
    { x: 13, y: 7 },
    { x: 14, y: 7 },
    { x: 15, y: 7 },
  ];
  var dir2 = LEFT;
  var nextDir2 = LEFT;
  var growing2 = false;

  function randomFood(exclude) {
    var occupied = exclude || {};
    var x, y, ok;
    do {
      x = Math.floor(Math.random() * COLS);
      y = Math.floor(Math.random() * ROWS);
      ok = true;
      for (var i = 0; i < snake.length; i++) {
        if (snake[i].x === x && snake[i].y === y) { ok = false; break; }
      }
      if (ok) {
        for (var j = 0; j < snake2.length; j++) {
          if (snake2[j].x === x && snake2[j].y === y) { ok = false; break; }
        }
      }
      if (food && x === food.x && y === food.y) ok = false;
    } while (!ok);
    return { x: x, y: y };
  }

  // 每帧更新一次方向
  function updateDir() {
    // 主蛇：随机转向
    var r = Math.random();
    if (r < 0.08) {
      var possible = [];
      if (!(dir.x === 1 && dir.y === 0)) possible.push(UP);
      if (!(dir.x === -1 && dir.y === 0)) possible.push(DOWN);
      if (!(dir.x === 0 && dir.y === 1)) possible.push(LEFT);
      if (!(dir.x === 0 && dir.y === -1)) possible.push(RIGHT);
      // 保留当前方向
      possible.push(dir);
      nextDir = possible[Math.floor(Math.random() * possible.length)];
    }
    // 如果食物在附近，倾向去吃
    var head = snake[0];
    if (food.x < head.x && dir.x !== 1) { if (Math.random() < 0.3) nextDir = LEFT; }
    else if (food.x > head.x && dir.x !== -1) { if (Math.random() < 0.3) nextDir = RIGHT; }
    else if (food.y < head.y && dir.y !== 1) { if (Math.random() < 0.3) nextDir = UP; }
    else if (food.y > head.y && dir.y !== -1) { if (Math.random() < 0.3) nextDir = DOWN; }

    // 次要蛇：随机走，但尽量避开主蛇
    if (Math.random() < 0.12) {
      var p = [];
      if (snake2[0].y > 0) p.push(UP);
      if (snake2[0].y < ROWS - 1) p.push(DOWN);
      if (snake2[0].x > 0) p.push(LEFT);
      if (snake2[0].x < COLS - 1) p.push(RIGHT);
      // 避免反向
      p = p.filter(function(d) { return d.x !== -dir2.x || d.y !== -dir2.y; });
      if (p.length > 0) nextDir2 = p[Math.floor(Math.random() * p.length)];
    }
  }

  // 移动蛇
  function moveSnake(snakeArray, direction, growingFlag) {
    var head = snakeArray[0];
    var newHead = { x: head.x + direction.x, y: head.y + direction.y };

    // 穿墙
    if (newHead.x < 0) newHead.x = COLS - 1;
    if (newHead.x >= COLS) newHead.x = 0;
    if (newHead.y < 0) newHead.y = ROWS - 1;
    if (newHead.y >= ROWS) newHead.y = 0;

    snakeArray.unshift(newHead);
    if (!growingFlag) {
      snakeArray.pop();
    }
  }

  // 游戏主循环（慢速，适合像素动画）
  var tick = 0;
  function gameLoop() {
    tick++;

    // 每隔几帧更新方向
    if (tick % 8 === 0) {
      updateDir();
    }

    // 每隔固定帧数移动
    if (tick % 12 === 0) {
      dir = nextDir;
      dir2 = nextDir2;

      // 检查主蛇吃食物
      var head = snake[0];
      var nextHead = { x: head.x + dir.x, y: head.y + dir.y };
      if (nextHead.x < 0) nextHead.x = COLS - 1;
      if (nextHead.x >= COLS) nextHead.x = 0;
      if (nextHead.y < 0) nextHead.y = ROWS - 1;
      if (nextHead.y >= ROWS) nextHead.y = 0;
      if (nextHead.x === food.x && nextHead.y === food.y) {
        growing = true;
      } else {
        growing = false;
      }

      moveSnake(snake, dir, growing);
      moveSnake(snake2, dir2, growing2);
      growing2 = false;

      // 主蛇吃到了 -> 新食物
      if (snake[0].x === food.x && snake[0].y === food.y) {
        food = randomFood();
      }

      // 次要蛇撞到主蛇时重置
      var head2 = snake2[0];
      for (var i = 0; i < snake.length; i++) {
        if (snake[i].x === head2.x && snake[i].y === head2.y) {
          snake2 = [
            { x: 13, y: 7 },
            { x: 14, y: 7 },
            { x: 15, y: 7 },
          ];
          dir2 = LEFT;
          nextDir2 = LEFT;
          break;
        }
      }

      draw();
    }

    requestAnimationFrame(gameLoop);
  }

  // ── 绘制 ──
  function draw() {
    ctx.clearRect(0, 0, 160, 160);

    // 背景网格（极暗）
    ctx.strokeStyle = '#1a1a2e';
    ctx.lineWidth = 0.5;
    for (var x = 0; x <= COLS; x++) {
      ctx.beginPath();
      ctx.moveTo(x * TILE, 0);
      ctx.lineTo(x * TILE, 160);
      ctx.stroke();
    }
    for (var y = 0; y <= ROWS; y++) {
      ctx.beginPath();
      ctx.moveTo(0, y * TILE);
      ctx.lineTo(160, y * TILE);
      ctx.stroke();
    }

    // 食物（知识方块 — 金色 + 闪烁）
    ctx.fillStyle = '#FFD700';
    ctx.shadowColor = '#FFD700';
    ctx.shadowBlur = tick % 20 < 10 ? 6 : 2;
    ctx.fillRect(food.x * TILE + 1, food.y * TILE + 1, TILE - 2, TILE - 2);
    ctx.shadowBlur = 0;

    // 主蛇（克莱因蓝）
    for (var i = 0; i < snake.length; i++) {
      var s = snake[i];
      if (i === 0) {
        // 蛇头：更亮
        ctx.fillStyle = '#1A67FF';
        ctx.fillRect(s.x * TILE + 1, s.y * TILE + 1, TILE - 2, TILE - 2);
        // 眼睛
        ctx.fillStyle = '#ffffff';
        var ex = dir.x === 1 ? 6 : dir.x === -1 ? 2 : 4;
        var ey = dir.y === 1 ? 6 : dir.y === -1 ? 2 : 4;
        ctx.fillRect(s.x * TILE + ex, s.y * TILE + ey, 2, 2);
      } else {
        // 蛇身渐变
        var alpha = 1 - (i / snake.length) * 0.5;
        ctx.fillStyle = 'rgba(0, 47, 167, ' + alpha + ')';
        ctx.fillRect(s.x * TILE + 1, s.y * TILE + 1, TILE - 2, TILE - 2);
      }
    }

    // 次要蛇（金色）
    for (var j = 0; j < snake2.length; j++) {
      var s2 = snake2[j];
      if (j === 0) {
        ctx.fillStyle = '#FFB800';
        ctx.fillRect(s2.x * TILE + 2, s2.y * TILE + 2, TILE - 4, TILE - 4);
        ctx.fillStyle = '#000';
        ctx.fillRect(s2.x * TILE + (dir2.x === 1 ? 6 : 3), s2.y * TILE + (dir2.y === 1 ? 6 : 3), 2, 2);
      } else {
        ctx.fillStyle = '#CC8800';
        ctx.fillRect(s2.x * TILE + 2, s2.y * TILE + 2, TILE - 4, TILE - 4);
      }
    }

    // 边缘发光（低电量指示风格）
    ctx.strokeStyle = 'rgba(0, 47, 167, 0.15)';
    ctx.lineWidth = 1;
    ctx.strokeRect(0, 0, 160, 160);
  }

  // ── 启动 ──
  // 首次食物不落在蛇身上
  food = randomFood();

  // 初始绘制
  draw();
  gameLoop();
})();
</script>
