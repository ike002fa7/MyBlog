---
import StatsCounter from './StatsCounter.astro';

interface Props { title: string; date: Date; slug: string; excerpt?: string; tags?: string[]; }
const { title, date, slug, excerpt, tags } = Astro.props;
---
<article class="group border-b border-gray-100 py-8 last:border-b-0">
  <a href={`/blog/${slug}`} class="block">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-lg font-semibold text-gray-900 group-hover:text-klein transition-colors">{title}</h2>
      <time class="shrink-0 font-mono text-xs text-gray-400">{date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}</time>
    </div>
    {excerpt && <p class="mt-2 text-sm leading-relaxed text-gray-500 line-clamp-2">{excerpt}</p>}
  </a>
  <div class="mt-3 flex items-center gap-4">
    <StatsCounter slug={slug} />
    {tags && tags.map((tag) => (<span class="rounded-full bg-gray-100 px-2.5 py-0.5 font-mono text-xs text-gray-500">#{tag}</span>))}
  </div>
</article>
