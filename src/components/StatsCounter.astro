---
interface Props { slug: string; }
const { slug } = Astro.props;

const SUPABASE_URL = 'https://eiakfxsvzmtvvfojtkln.supabase.co';
const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVpYWtmeHN2em10dnZmb2p0a2xuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzgzNzU5NjksImV4cCI6MjA5Mzk1MTk2OX0.Rdg3IcgL0_GUQjtnrjswVk-MNNPaZxOhevQBBAWYM90';
---
<span class="stats-counter inline-flex items-center gap-4 font-mono text-xs text-gray-400" data-slug={slug}>
  <span class="inline-flex items-center gap-1">
    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
    <span class="views-count">---</span>
  </span>
  <span class="inline-flex items-center gap-1">
    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
    <span class="likes-count">---</span>
  </span>
  <span class="inline-flex items-center gap-1">
    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 01-.923 1.785A5.969 5.969 0 006 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337z"/></svg>
    <span class="comments-count">---</span>
  </span>
</span>
<script>
  (function() {
    var SUPABASE_URL = 'https://eiakfxsvzmtvvfojtkln.supabase.co';
    var SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVpYWtmeHN2em10dnZmb2p0a2xuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzgzNzU5NjksImV4cCI6MjA5Mzk1MTk2OX0.Rdg3IcgL0_GUQjtnrjswVk-MNNPaZxOhevQBBAWYM90';
    document.querySelectorAll('.stats-counter').forEach(function(c) {
      var slug = c.getAttribute('data-slug');
      fetch(SUPABASE_URL + '/rest/v1/blog_stats?slug=eq.' + encodeURIComponent(slug) + '&select=views,likes', {
        headers: { 'apikey': SUPABASE_KEY, 'Authorization': 'Bearer ' + SUPABASE_KEY }
      }).then(function(r) { return r.json(); }).then(function(data) {
        var d = data[0];
        if (d) {
          c.querySelector('.views-count').textContent = d.views || 0;
          c.querySelector('.likes-count').textContent = d.likes || 0;
        }
      });
    });
  })();
</script>
