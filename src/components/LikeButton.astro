---
interface Props { slug: string; }
const { slug } = Astro.props;
---
<button class="like-btn group inline-flex items-center gap-2 font-mono text-sm text-gray-400 hover:text-klein transition-colors" data-slug={slug} data-liked="false">
  <svg class="h-5 w-5 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
  <span>点赞</span>
  <span class="like-count">0</span>
</button>
<script>
  (function() {
    var SUPABASE_URL = 'https://eiakfxsvzmtvvfojtkln.supabase.co';
    var SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVpYWtmeHN2em10dnZmb2p0a2xuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzgzNzU5NjksImV4cCI6MjA5Mzk1MTk2OX0.Rdg3IcgL0_GUQjtnrjswVk-MNNPaZxOhevQBBAWYM90';
    document.querySelectorAll('.like-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (this.dataset.liked === 'true') return;
        var slug = this.dataset.slug;
        fetch(SUPABASE_URL + '/rest/v1/rpc/increment_likes', {
          method: 'POST',
          headers: { 'apikey': SUPABASE_KEY, 'Authorization': 'Bearer ' + SUPABASE_KEY, 'Content-Type': 'application/json' },
          body: JSON.stringify({ p_slug: slug })
        }).then(function(r) { return r.text(); }).then(function(data) {
          if (data) {
            this.querySelector('.like-count').textContent = data;
            this.dataset.liked = 'true';
            this.classList.add('text-klein');
          }
        }.bind(this));
      });
    });
  })();
</script>
