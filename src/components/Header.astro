---
const navItems = [
  { label: '首页', href: '/' },
  { label: '博客', href: '/blog' },
];
---
<header class="border-b border-gray-100">
  <nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-5">
    <a href="/" class="text-xl font-bold tracking-tight text-klein hover:text-klein-400 transition-colors">MyBlog</a>
    <ul class="flex gap-8">
      {navItems.map((item) => (
        <li><a href={item.href} class="text-sm font-medium text-gray-500 hover:text-klein transition-colors">{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>
