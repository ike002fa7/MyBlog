---
interface Props { currentPath?: string; }
const { currentPath = '' } = Astro.props;
const navItems = [
  { label: '首页', href: '/' },
  { label: '博客', href: '/blog' },
  { label: '关于我', href: '/about' },
];
---
<header class="sticky top-0 z-30 border-b border-gray-100 bg-white/80 backdrop-blur-md transition-colors dark:border-gray-800 dark:bg-gray-950/80" id="site-header">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="group flex items-center gap-2 text-xl font-bold tracking-tight">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-klein text-sm font-bold text-white transition-transform group-hover:scale-110">X</span>
      <span class="text-gray-900 transition-colors dark:text-white">X-ATCN</span>
    </a>
    <div class="flex items-center gap-2">
      <!-- 桌面导航 -->
      <ul class="hidden gap-1 md:flex">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <li>
              <a href={item.href} 
                 class={`px-3 py-2 text-sm font-bold rounded-lg transition-all
                   ${isActive 
                     ? 'bg-klein text-white shadow-sm' 
                     : 'text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white'
                   }`}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
      <!-- 搜索按钮 -->
      <button id="search-toggle" class="flex h-10 w-10 items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 transition-colors dark:text-gray-400 dark:hover:bg-gray-800" aria-label="搜索" title="搜索 (Ctrl+K)">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </button>
      <!-- 移动端汉堡按钮 -->
      <button id="menu-toggle" class="flex h-10 w-10 items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100 md:hidden dark:text-gray-400 dark:hover:bg-gray-800" aria-label="菜单">
        <svg id="menu-open" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg id="menu-close" class="hidden h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
  </nav>
  <!-- 移动端菜单面板 -->
  <div id="mobile-menu" class="hidden border-t border-gray-100 bg-white px-6 pb-4 pt-2 md:hidden dark:border-gray-800 dark:bg-gray-950">
    <ul class="flex flex-col gap-1">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <li>
            <a href={item.href} 
               class={`block rounded-lg px-3 py-2.5 text-sm font-bold transition-all
                 ${isActive 
                   ? 'bg-klein text-white' 
                   : 'text-gray-500 hover:bg-gray-50 dark:text-gray-400 dark:hover:bg-gray-800'
                 }`}>
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</header>

<!-- 搜索弹窗 -->
<div id="search-overlay" class="fixed inset-0 z-50 hidden items-start justify-center bg-black/40 pt-[15vh] backdrop-blur-sm">
  <div class="mx-4 w-full max-w-xl rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-gray-700 dark:bg-gray-900">
    <div class="flex items-center border-b border-gray-100 px-4 dark:border-gray-700">
      <svg class="h-5 w-5 shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      <input id="search-input" type="text" placeholder="搜索文章…" class="w-full bg-transparent px-3 py-4 text-sm text-gray-900 outline-none placeholder:text-gray-400 dark:text-white dark:placeholder:text-gray-500" autofocus />
      <kbd class="hidden rounded border border-gray-200 px-1.5 py-0.5 font-mono text-[10px] text-gray-400 sm:inline-block dark:border-gray-600">Esc</kbd>
    </div>
    <div id="search-results" class="max-h-72 overflow-y-auto p-2">
      <p class="px-3 py-6 text-center text-sm text-gray-400">输入关键词搜索文章标题和摘要</p>
    </div>
  </div>
</div>

<script>
  // 汉堡菜单
  document.getElementById('menu-toggle').addEventListener('click', () => {
    const menu = document.getElementById('mobile-menu');
    const open = document.getElementById('menu-open');
    const close = document.getElementById('menu-close');
    menu.classList.toggle('hidden');
    open.classList.toggle('hidden');
    close.classList.toggle('hidden');
  });

  // 搜索功能
  (function() {
    var overlay = document.getElementById('search-overlay');
    var input = document.getElementById('search-input');
    var results = document.getElementById('search-results');
    var index = [];

    // 加载搜索索引
    fetch('/search-index.json')
      .then(function(r) { return r.json(); })
      .then(function(data) { index = data; });

    function openSearch() {
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
      setTimeout(function() { input.focus(); }, 100);
    }
    function closeSearch() {
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
      input.value = '';
      results.innerHTML = '<p class="px-3 py-6 text-center text-sm text-gray-400">输入关键词搜索文章标题和摘要</p>';
    }

    document.getElementById('search-toggle').addEventListener('click', openSearch);
    overlay.addEventListener('click', function(e) { if (e.target === overlay) closeSearch(); });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeSearch();
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); openSearch(); }
    });

    var categories = ['技术','工具','VPS','AI','3C数码'];
    var catColors = { '技术':'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300', '工具':'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300', 'VPS':'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300', 'AI':'bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-300', '3C数码':'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300' };

    input.addEventListener('input', function() {
      var q = this.value.trim().toLowerCase();
      if (!q) { results.innerHTML = '<p class="px-3 py-6 text-center text-sm text-gray-400">输入关键词搜索文章标题和摘要</p>'; return; }
      var found = index.filter(function(p) {
        return p.title.toLowerCase().includes(q) || p.excerpt.toLowerCase().includes(q) || (p.tags||[]).some(function(t) { return t.toLowerCase().includes(q); });
      });
      if (!found.length) {
        results.innerHTML = '<p class="px-3 py-6 text-center text-sm text-gray-400">未找到匹配文章</p>';
        return;
      }
      results.innerHTML = found.map(function(p) {
        var catClass = catColors[p.category] || 'bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400';
        return '<a href="/blog/' + p.slug + '" class="flex flex-col gap-1 rounded-xl px-3 py-3 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">' +
          '<div class="flex items-center gap-2"><span class="rounded-full px-2 py-0.5 text-[10px] font-medium ' + catClass + '">' + (p.category||'') + '</span><span class="text-sm font-medium text-gray-900 dark:text-white">' + p.title + '</span></div>' +
          '<p class="line-clamp-1 text-xs text-gray-400">' + (p.excerpt||'') + '</p></a>';
      }).join('');
    });
  })();
</script>
